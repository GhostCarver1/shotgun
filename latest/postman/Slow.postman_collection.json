              "name": "Login Bradley",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();\r",
                      "const token = json.token || json.access_token || json.jwt || json.sessionToken || json.id_token;\r",
                      "if (token) {\r",
                      "    pm.environment.set(\"bradley_token\", token);\r",
                      "    pm.environment.set(\"bradley_user_id\", json.user_id);\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
