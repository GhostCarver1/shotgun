                  "pm.test(\"Response body is valid JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Response status is failure\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"failure\");",
